# Copy to .env.local only if you need to change something. Never commit .env.local.
# Everything starting with VITE_ is built into the JavaScript and is PUBLIC: never put a secret here.

# Base URL of the backend API, as seen by the browser.
# Default "/api" uses the Vite dev proxy (vite.config.ts). Only change it if the backend runs elsewhere.
VITE_API_BASE_URL="/api"
