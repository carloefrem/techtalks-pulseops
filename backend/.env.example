# Copy this file to .env and fill in your own values. Never commit .env.
NODE_ENV=development
PORT=3001

# Frontend allowed by CORS (Vite dev server)
FRONTEND_ORIGIN="http://localhost:5173"

# Your local PostgreSQL 18.7 (used from PULSE-69 on). Fill in YOUR user/password.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pulseops_dev"

# Signs login sessions (PULSE-87). At least 32 random characters, different from everyone else's.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-with-a-long-random-secret-of-at-least-32-chars"

# Used ONLY by tests (npm run db:test:prepare / npm run test:db).
# Must be a separate local database whose name ends in _test; the test guard refuses anything else.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pulseops_test"
