# Copy this file to .env and fill in your own values. Never commit .env.
NODE_ENV=development
PORT=3001

# Frontend allowed by CORS (Vite dev server)
FRONTEND_ORIGIN="http://localhost:5173"

# Your local PostgreSQL 18.7 (used from PULSE-69 on). Fill in YOUR user/password.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/pulseops_dev"
